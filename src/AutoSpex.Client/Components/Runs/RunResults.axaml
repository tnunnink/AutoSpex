<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="http://schemas.actiprosoftware.com/avaloniaui"
                    xmlns:properties="clr-namespace:AutoSpex.Client.Resources.Properties"
                    xmlns:observers="clr-namespace:AutoSpex.Client.Observers"
                    xmlns:components="clr-namespace:AutoSpex.Client.Components">

    <Design.PreviewWith>
        <Border Width="800" Height="500">
            <ContentControl
                Content="{x:Static components:TestData.RunTest}"
                ContentTemplate="{DynamicResource RunResults}" />
        </Border>
    </Design.PreviewWith>

    <DataTemplate x:Key="RunResults" x:DataType="observers:RunObserver">

        <DockPanel Margin="15">

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">

                <ContentControl
                    Grid.Column="0"
                    Content="{Binding }"
                    ContentTemplate="{StaticResource RunStatus}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">

                    <!--<TabStrip
                        DockPanel.Dock="Right"
                        ItemContainerTheme="{DynamicResource TabStripItemExpandable}"
                        BorderThickness="0">

                        <TabStripItem
                            properties:Icon.Theme="{StaticResource IconLineListCheck}"
                            Content="Checks" />
                        <TabStripItem
                            properties:Icon.Theme="{StaticResource IconLineListTable}"
                            Content="Data" />
                        <TabStripItem
                            properties:Icon.Theme="{StaticResource IconLineFile}"
                            Content="Logs" />

                    </TabStrip>-->

                    <Button
                        Command="{Binding UpdateViewCommand}"
                        CommandParameter="Results"
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconLineListCheck}"
                        Classes.accent="{Binding SelectedView, Converter={StaticResource EqualToConverter}, ConverterParameter='Results'}"
                        ToolTip.Tip="Results" />

                    <Button
                        Command="{Binding UpdateViewCommand}"
                        CommandParameter="Data"
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconLineListTable}"
                        Classes.accent="{Binding SelectedView, Converter={StaticResource EqualToConverter}, ConverterParameter='Data'}"
                        ToolTip.Tip="Data" />

                    <Button
                        Command="{Binding UpdateViewCommand}"
                        CommandParameter="Logs"
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconLineFile}"
                        Classes.accent="{Binding SelectedView, Converter={StaticResource EqualToConverter}, ConverterParameter='Logs'}"
                        ToolTip.Tip="Logs" />

                    <Border
                        Width="1"
                        Background="{a:ThemeResource Container1BorderBrush}"
                        Margin="0 7" />

                    <Button
                        Command="{Binding RunCommand}"
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconFilledLightning}"
                        ToolTip.Tip="Run" />

                    <Button
                        Command="{Binding OpenNodeCommand}"
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconLineLaunch}"
                        ToolTip.Tip="Open" />

                    <Button
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconLineDownload}"
                        ToolTip.Tip="Export" />

                </StackPanel>

            </Grid>

            <ContentControl
                DockPanel.Dock="Top"
                Content="{Binding}"
                ContentTemplate="{StaticResource RunFilter}"
                Margin="0 10" />

            <!--<TextBox
                DockPanel.Dock="Top"
                Watermark="Filters results"
                Text="{Binding FilterText}"
                Theme="{StaticResource TextBoxOutlineHighlight}"
                FontSize="{a:ThemeResource DefaultFontSizeSmall}"
                Background="Transparent"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                BorderThickness="1"
                Margin="0 10">

                <TextBox.InnerLeftContent>
                    <Button
                        Theme="{StaticResource IconButton}"
                        properties:Icon.Theme="{StaticResource IconLineCircleHalfFill}"
                        ToolTip.Tip="Open" />
                    ~1~<PathIcon
                        Theme="{StaticResource IconLineSearch}"
                        Margin="10 0 0 0"
                        Classes="size-sm"
                        Foreground="{a:ThemeResource DefaultForegroundBrushTertiary}" />@1@
                </TextBox.InnerLeftContent>

                <Interaction.Behaviors>
                    <TextBoxSelectAllOnGotFocusBehavior />
                </Interaction.Behaviors>

            </TextBox>-->

            <ContentControl
                Content="{Binding}"
                ContentTemplate="{StaticResource EvaluationList}"
                IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}" />

        </DockPanel>

    </DataTemplate>
</ResourceDictionary>